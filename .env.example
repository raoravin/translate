# MongoDB — the SAME database the main Courtbook app uses. This service reads
# the English source collections (coi_entries, coi_hierarchy, sections,
# subordinate_sections, posts) and owns the *_translations cache collections.
MONGO_URI=

# Google Cloud Translation API (v2, API-key auth).
# Enable "Cloud Translation API" on the GCP project and create an API key.
GOOGLE_TRANSLATE_API_KEY=

# Origin allowed to call this service cross-origin (e.g. https://courtbook.in).
# Defaults to "*" when unset.
ALLOWED_ORIGIN=
