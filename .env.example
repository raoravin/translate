# Google Cloud Translation API (v2, API-key auth).
# Enable "Cloud Translation API" on the GCP project and create an API key.
GOOGLE_TRANSLATE_API_KEY=

# Shared secret callers must send as `Authorization: Bearer <secret>`.
# This service spends money per call — never deploy it without this set.
# Generate one with: openssl rand -hex 32
TRANSLATE_API_SECRET=
